{
  "name": "cara-animation",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Cara the Capybara: painted p5.brush animation for a children's YouTube series (fork of ClaudeAnimationBase)",
  "scripts": {
    "sheet": "node render.mjs --loop=cara --sheet=1 --cols=1 --w=1920 --out=out/check/cara.jpg",
    "video": "node render.mjs --frames --workers=4 --fresh && node render.mjs --encode",
    "shorts": "node render.mjs --vertical --frames --workers=4 --fresh && node render.mjs --vertical --encode",
    "docs": "node render.mjs --loop=cara --sheet=1 --cols=1 --w=1920 --out=docs/cara_poses.jpg && node render.mjs --loop=dragon --sheet=1.3 --cols=1 --w=1920 --crop=0,200,1920,640 --out=docs/dewi.jpg"
  },
  "dependencies": {
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.11.0"
  }
}
